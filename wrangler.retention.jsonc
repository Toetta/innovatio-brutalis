{
  // Separate scheduled-only Worker, not the site's Pages Functions.
  "name": "innovatio-brutalis-gdpr-retention",
  "main": "workers/retention-cron.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "innovatio_brutalis_db",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_UUID"
    }
  ],
  "vars": {
    "GDPR_RETENTION_CRON_ENABLED": "false",
    "GDPR_RETENTION_PRODUCTION_APPROVED": "false"
  },
  "observability": { "enabled": true }
}
